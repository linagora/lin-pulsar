    "@superset-ui/embedded-sdk": "0.4.0",
    "@vueuse/core": "14.3.0",
    "axios": "1.18.1",
    "interactjs": "1.10.27",
    "p-limit": "7.3.0",
    "papaparse": "5.5.4",
    "pinia": "3.0.4",
    "quasar": "2.21.1",
    "vue": "3.5.39",
    "vue-i18n": "11.4.6",
    "vue-router": "5.1.0",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@module-federation/vite": "1.16.13",
    "@quasar/vite-plugin": "1.12.0",
    "@types/node": "26.1.1",
    "@types/papaparse": "5.5.2",
    "@typescript-eslint/parser": "8.63.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.4.11",
    "dayjs": "1.11.21",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-headers": "1.3.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "63.0.12",
    "eslint-plugin-vue": "10.9.2",
    "globals": "17.13.0",
    "happy-dom": "20.10.6",
    "jiti": "2.7.0",
    "prettier": "3.9.4",
    "rxjs": "7.8.2",
    "sass-embedded": "1.100.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.3",
    "vite-plugin-dts": "5.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7"
  }
