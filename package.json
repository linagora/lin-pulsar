{
  "name": "@linagora/lin-pulsar",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=dot",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@linagora/lin-pulsar-core": "0.1.5",
    "@superset-ui/embedded-sdk": "0.4.0",
    "@vue/devtools-api": "8.2.1",
    "@vueuse/core": "15.0.0",
    "axios": "1.21.0",
    "interactjs": "1.10.28",
    "p-limit": "7.3.3",
    "papaparse": "5.7.0",
    "pinia": "4.1.0",
    "quasar": "2.35.2",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "5.4.0",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@module-federation/vite": "1.23.7",
    "@quasar/vite-plugin": "2.0.2",
    "@types/node": "26.6.6",
    "@types/papaparse": "5.5.2",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "dayjs": "1.11.23",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-headers": "1.3.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "rxjs": "7.8.2",
    "sass-embedded": "1.107.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-dts": "5.1.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
